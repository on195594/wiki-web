{
  "name": "wiki-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node --experimental-strip-types scripts/sync-wiki.ts",
    "publish": "node --experimental-strip-types scripts/publish.ts",
    "predev": "npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types scripts/test-sync.ts",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "npm run sync && astro check && astro build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.15.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "astro": "7.3.5",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.17.1",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  }
}
